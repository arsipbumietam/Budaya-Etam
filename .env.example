# Contoh bagi systemd/container. server.py tidak memuat .env secara otomatis.
BPK_ENV=production
BPK_DATA_DIR=/srv/bpk-kaltim/data
BPK_ALLOWED_ORIGINS=https://domain-resmi-instansi.example
# Wajib diisi secara rahasia untuk instalasi produksi pertama. Jangan simpan dalam repositori.
BPK_INITIAL_PASSWORD=
